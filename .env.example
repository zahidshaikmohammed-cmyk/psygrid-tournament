# Copy this file to .env (or export these directly in your shell) before
# running `python main.py`. Nothing here has a hard-coded default in code.

# --- Required for live Telegram alerts ---------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- RealMarketAPI --------------------------------------------------------
# Defaults to the endpoint given in the engine spec; override if needed.
REALMARKET_API_URL=http://140.245.226.102:8080/public/m1-live.json

# --- Storage ---------------------------------------------------------------
PSYGRID_DB_PATH=psygrid.sqlite3

# --- Loop timing -------------------------------------------------------
PSYGRID_SCAN_INTERVAL_SECONDS=20
PSYGRID_TOURNAMENT_INTERVAL_MINUTES=30
PSYGRID_API_TIMEOUT_SECONDS=15

# --- Data quality gates -----------------------------------------------
PSYGRID_FRESHNESS_MAX_SECONDS=180
PSYGRID_HISTORY_MIN_CANDLES=200
PSYGRID_MAX_ROLLING_CANDLES=1600
PSYGRID_EXPECTED_INSTRUMENTS=10

# --- Setup / execution gates --------------------------------------------
PSYGRID_MIN_RR=1.5
PSYGRID_MAX_SETUP_AGE_MINUTES=20
PSYGRID_MAX_TRAVEL_RATIO=0.75
PSYGRID_ABNORMAL_VOL_MULTIPLE=3.5

# --- Scoring -------------------------------------------------------------
PSYGRID_MIN_QUALITY_SCORE=78
PSYGRID_HISTORICAL_MIN_SAMPLE=20
